# NexResto Frontend — Environment Configuration
# Copy this file to .env and update the values to match your setup.

# Base URL of your backend API (no trailing slash)
# Example: http://localhost:8000/api (local)
#          https://api.yourdomain.com/api (production)
VITE_API_URL=http://localhost:8000/api

# App display name (used in browser tab)
VITE_APP_NAME=NexResto
